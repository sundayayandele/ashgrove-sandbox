# Copy to .env and adjust.
ASHGROVE_TAG=0.1.0
ASHGROVE_SEED=42

# none: trust X-Actor / X-On-Behalf-Of / X-Roles headers (beginner)
# keycloak: require Keycloak tokens (start with --profile identity)
AUTH_MODE=none
KEYCLOAK_ADMIN_PASSWORD=change-me

# Refunds above this need a support-lead approval
REFUND_AUTO_LIMIT_EUR=100

# Resilience practice: fail 10% of requests, add 500 ms latency
CHAOS_ERROR_RATE=0
CHAOS_LATENCY_MS=0

GRAFANA_ADMIN_PASSWORD=change-me
